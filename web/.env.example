# ---------------------------------------------------------------------------
# Green Future EV platform — environment variables
# Copy to .env.local for development. Everything is optional in development;
# items marked REQUIRED IN PRODUCTION must be set before launch (see LAUNCH.md).
# ---------------------------------------------------------------------------

# Public site URL (canonical links, emails, sitemap). REQUIRED IN PRODUCTION
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random characters; signs upload receipts and hashes IPs. REQUIRED IN PRODUCTION
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Postgres (Supabase / Neon / RDS). Unset = embedded PGlite in .data/pglite
DATABASE_URL=
DATABASE_POOL_MAX=5
# PGLITE_DIR=.data/pglite

# Photo storage. Unset = local disk (.data/uploads). Production: s3
STORAGE_DRIVER=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email via Postmark. Unset = messages are written to .data/outbox
POSTMARK_SERVER_TOKEN=
POSTMARK_STREAM=outbound
EMAIL_FROM="Green Future <offers@greenfuturevehicles.com>"
# Comma-separated team inboxes for new-lead alerts (also editable in Admin › Settings)
ADMIN_NOTIFY_EMAILS=

# WhatsApp Business Platform (Meta Cloud API). Unset = simulated
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_RECEIVED=quote_received
WHATSAPP_TEMPLATE_OFFER=quote_offer

# Cloudflare Turnstile (bot protection on the quote form). Unset = disabled
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container (GA4 + Google Ads tags live inside GTM)
NEXT_PUBLIC_GTM_ID=

# Business details shown on the site (defaults in src/lib/site.ts). CONFIRM WITH CLIENT
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPENING_HOURS=
NEXT_PUBLIC_ICO_NUMBER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Quote submissions allowed per IP per hour (default 6; raise only for testing)
QUOTE_RATE_LIMIT_PER_HOUR=6

# Production safety valve: allow the dev outbox in production (never in real use)
ALLOW_SIMULATED_MESSAGES=false
# Protects /api/cron/* routes (Vercel Cron sends it as a bearer token)
CRON_SECRET=
